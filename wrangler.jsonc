{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-realtime-global-index-prediction-system",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    // Output of `npm run build` (copied from frontend/dist)
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/market-data"]
  }
}
