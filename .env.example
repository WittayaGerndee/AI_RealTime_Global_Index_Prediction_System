# ==============================================================================
# AI Real-Time Global Index Prediction System - Environment Configuration
# ==============================================================================

# --- System & Environment ---
PROJECT_NAME="AI Real-Time Global Index Prediction System"
ENVIRONMENT="production" # development, staging, production
LOG_LEVEL="INFO"
SECRET_KEY="replace_with_a_secure_random_32_character_secret_key"
API_V1_STR="/api"

# --- Database (TimescaleDB / PostgreSQL) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=global_index_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@postgres:5432/global_index_ai

# --- Redis (Real-time State & Pub/Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://redis:6379/0

# --- Market Data Providers ---
# Choose provider: twelve_data, itick, mock_replay
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
ITICK_API_KEY=your_itick_api_key_here

# Mock Replay Settings (useful for deterministic tests & offline simulation)
MOCK_REPLAY_SPEED=1.0 # 1.0 = real-time, 5.0 = 5x speed
MOCK_REPLAY_ENABLED=false

# Prediction Inference Interval in seconds (e.g. 1, 5, 10, 30)
PREDICTION_INTERVAL_SECONDS=5

# --- Cloudflare Tunnel (cloudflared) ---
# Obtain token from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""
CLOUDFLARE_DOMAIN="api.yourdomain.com"

# --- Frontend Deployment ---
# URL of the backend API as seen by the browser
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_WS_URL="ws://localhost:8000/ws"
# Set to 'true' to allow standalone demo mode when backend is unreachable
VITE_STANDALONE_DEMO_ENABLED="true"
